  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id, workspace_id, parent_id,\n                file_type as \"file_type: crate::fs::models::FileType\",\n                name, path, hash, versions,\n                deleted_at, created_at, updated_at\n            FROM files\n            WHERE workspace_id = $1\n              AND path LIKE $2 || '%'\n              AND path != $2\n              AND deleted_at IS NULL\n            ORDER BY path ASC\n            ",
