  "query": "\n        SELECT\n            id,\n            workspace_id,\n            parent_id,\n            file_type as \"file_type: FileType\",\n            name,\n            path,\n            hash,\n            versions,\n            deleted_at,\n            created_at,\n            updated_at\n        FROM files\n        WHERE workspace_id = $1\n          AND deleted_at IS NULL\n        ORDER BY path ASC\n        ",
